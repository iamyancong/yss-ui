{
  "name": "@yss-ui/hooks",
  "version": "1.2.0",
  "description": "YSS UI Hooks 包",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@vueuse/core": "^10.5.0",
    "screenfull": "^6.0.2",
    "vue": "^3.3.8",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "ant-design-vue": "^4.0.7",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^3.9.1"
  }
}
