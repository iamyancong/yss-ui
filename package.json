{
  "name": "yss-ui",
  "version": "1.0.0",
  "description": "基于 Vue 3、Ant Design Vue 与 VXE-Table 的企业级中后台组件库，内置表格/表单/主题与 Hooks 最佳实践",
  "private": true,
  "homepage": "https://github.com/iamyancong/yss-ui#readme",
  "license": "MIT",
  "scripts": {
    "docs:prepare": "node scripts/generateContributors.js && node scripts/generate-home-releases.js && node scripts/sync-skills-docs.js && node scripts/generate-coverage-matrix.js && node scripts/generate-llms.js",
    "predev": "pnpm docs:prepare",
    "dev": "dumi dev",
    "prebuild": "pnpm docs:prepare && pnpm validate:skills && pnpm validate:docs",
    "generate:contributors": "node scripts/generateContributors.js",
    "generate:coverage-matrix": "node scripts/generate-coverage-matrix.js",
    "build": "node scripts/build-fix.js",
    "build:docs:check": "node scripts/build-fix.js",
    "build:components": "pnpm -r --filter='./packages/*' run build",
    "build:packages:publishable": "pnpm --filter @yss-ui/utils --filter @yss-ui/theme --filter @yss-ui/hooks --filter @yss-ui/components run build",
    "prepreview": "pnpm docs:prepare",
    "preview": "dumi preview",
    "prepare": "husky install",
    "test": "vitest",
    "test:unit": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:node": "pnpm test:skills-sync && pnpm test:registry-artifacts && pnpm test:home-releases && pnpm test:release-detect && pnpm test:mcp && pnpm test:consumption-plugin && pnpm test:published-release",
    "test:mcp": "node --test packages/mcp/lib/tools.test.js",
    "test:package-consumer": "pnpm build:packages:publishable && node scripts/check-package-consumer.mjs",
    "test:registry-artifacts": "node --test scripts/check-registry-artifacts.test.mjs",
    "test:home-releases": "node --test scripts/generate-home-releases.test.js",
    "check:registry-artifacts": "node scripts/check-registry-artifacts.mjs",
    "lint": "pnpm lint:check --fix",
    "lint:check": "eslint packages/components/src packages/components/tools packages/components/build packages/hooks/src packages/utils/src packages/theme/src packages/mcp/lib packages/mcp/scripts packages/skills-cli/lib packages/skills-cli/bin docs vitest.config.ts --ext .vue,.js,.ts,.jsx,.tsx",
    "lint:ci": "pnpm lint:check --quiet",
    "lint:style": "pnpm lint:style:check --fix",
    "lint:style:check": "stylelint \"packages/**/*.{vue,css,less,scss}\" \"docs/**/*.{vue,css,less,scss}\"",
    "type-check": "vue-tsc --noEmit",
    "quality": "pnpm lint:ci && pnpm lint:style:check && pnpm type-check && pnpm test:coverage && pnpm test:node && pnpm test:package-consumer && pnpm validate:skills && pnpm validate:docs && pnpm build:docs:check",
    "generate:llms": "node scripts/generate-llms.js",
    "mcp:index": "node packages/mcp/scripts/build-index.js",
    "test:release-detect": "node scripts/lib/release-packages.test.js",
    "test:published-release": "node --test scripts/verify-published-release.test.mjs",
    "test:skills-sync": "node --test packages/skills-cli/lib/sync.test.js",
    "sync:skills": "node scripts/sync-skills.js --all",
    "sync:skills:ides": "node scripts/sync-skills.js --all --global-only",
    "sync:skills-docs": "node scripts/sync-skills-docs.js",
    "eval:skills": "node scripts/run-trigger-evals.js",
    "scan:skills": "node scripts/scan-skills-security.js",
    "validate:skills": "node scripts/validate-skills.js && node scripts/validate-docs.mjs --skills-only && node scripts/run-trigger-evals.js && node scripts/scan-skills-security.js",
    "validate:docs": "pnpm test:home-releases && node scripts/validate-docs.mjs",
    "release:patch": "node scripts/release-changed.js patch",
    "release:minor": "node scripts/release-changed.js minor",
    "release:major": "node scripts/release-changed.js major",
    "release:smart:patch": "node scripts/release-smart.js patch",
    "release:smart:minor": "node scripts/release-smart.js minor",
    "release:smart:major": "node scripts/release-smart.js major",
    "test:consumption-plugin": "node --test scripts/consumption-plugin.test.mjs",
    "test:consumption": "pnpm build:packages:publishable && node scripts/check-consumption.mjs",
    "test:consumption-types": "node scripts/check-consumption-types.mjs"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.0",
    "@formily/antdv": "2.0.1-beta.3",
    "@formily/core": "^2.3.0",
    "@formily/validator": "^2.3.0",
    "@formily/vue": "^2.3.0",
    "@vueuse/core": "^10.5.0",
    "ant-design-vue": "^4.0.7",
    "dayjs": "^1.11.13",
    "echarts": "^6.0.0",
    "vue": "^3.3.8",
    "vxe-pc-ui": "4.14.32",
    "vxe-table": "4.19.10",
    "xe-utils": "^3.7.9"
  },
  "devDependencies": {
    "@ant-design/icons-svg": "^4.4.2",
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.3",
    "@dumijs/preset-vue": "^2.4.14",
    "@dumijs/vue-meta": "2.4.14",
    "@gsap/react": "^2.1.2",
    "@types/node": "^20.8.10",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-vue": "^4.4.1",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vitest/coverage-v8": "1.6.1",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.6",
    "chalk": "4",
    "classnames": "^2.5.1",
    "dumi": "^2.4.23",
    "esbuild": "0.27.3",
    "esbuild-register": "^3.6.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^9.33.0",
    "father": "^4.3.6",
    "fs-extra": "^11.2.0",
    "gsap": "^3.15.0",
    "happy-dom": "^15.11.7",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "monaco-editor": "0.54.0",
    "monaco-editor-nls": "3.1.0",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.0",
    "postcss-less": "^6.0.0",
    "prettier": "^3.6.2",
    "react": "^18.2.0",
    "standard-version": "^9.5.0",
    "stylelint": "^15.11.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "tar": "^7.5.7",
    "typescript": "^5.6.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vitest": "^1.6.0",
    "vue-component-meta": "^3.3.11",
    "vue-tsc": "^2.1.6",
    "@babel/parser": "^7.29.0",
    "magic-string": "^0.30.21",
    "@vue/compiler-sfc": "^3.5.29"
  },
  "engines": {
    "node": ">=22.10.0",
    "pnpm": ">=8.6.0"
  },
  "packageManager": "pnpm@8.10.0",
  "keywords": [
    "vue3",
    "ui",
    "components",
    "design system",
    "ant-design-vue",
    "vxe-table",
    "table",
    "admin",
    "hooks",
    "theme",
    "dumi"
  ],
  "lint-staged": {
    "*.{vue,js,ts,jsx,tsx}": [
      "bash -c 'if [[ \"$0\" != */.agent/skills/* ]] && [[ \"$0\" != */packages/skills/*/examples/* ]]; then eslint --fix \"$0\"; fi'"
    ],
    "*.{css,less,scss}": [
      "bash -c 'if [[ \"$0\" != */.agent/skills/* ]] && [[ \"$0\" != */packages/skills/* ]]; then stylelint --fix \"$0\"; fi'"
    ],
    "*": "prettier --write --ignore-unknown"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.6.3"
    },
    "patchedDependencies": {
      "dumi@2.4.23": "patches/dumi@2.4.23.patch",
      "@dumijs/preset-vue@2.4.14": "patches/@dumijs__preset-vue@2.4.14.patch"
    }
  }
}
